{
  "version": "2026-08-18",
  "jurisdiction": "California",
  "source": {
    "agency": "California Fair Political Practices Commission",
    "manuals": "https://www.fppc.ca.gov/learn/campaign-rules/campaign-disclosure-manuals/",
    "campaign_rules": "https://www.fppc.ca.gov/learn/campaign-rules/"
  },
  "rules": [
    {
      "id": "committee.recipient.2000",
      "status": "active",
      "trigger": {
        "all": [
          {
            "field": "funding",
            "in": [
              "contributions",
              "mixed"
            ]
          },
          {
            "field": "political_receipts_estimate",
            "gte": 2000
          }
        ]
      },
      "result": {
        "category": "recipient_committee",
        "message": "Receiving $2,000 or more in contributions for political purposes may qualify the organization as a recipient committee.",
        "review": true
      },
      "source": "https://www.fppc.ca.gov/learn/campaign-rules/",
      "effective_date": null
    },
    {
      "id": "committee.ie.1000",
      "status": "active",
      "trigger": {
        "all": [
          {
            "field": "goal",
            "eq": "independent"
          },
          {
            "field": "independent_communication_amount",
            "gte": 1000
          }
        ]
      },
      "result": {
        "category": "independent_expenditure_committee",
        "message": "A person or entity paying $1,000 or more for a qualifying independent communication may qualify as an independent expenditure committee.",
        "review": true
      },
      "source": "https://www.fppc.ca.gov/learn/campaign-rules/when-and-where-to-file-campaign-statements/general-purpose-committees/",
      "effective_date": null
    },
    {
      "id": "committee.major-donor.10000",
      "status": "active",
      "trigger": {
        "all": [
          {
            "field": "funding",
            "in": [
              "own"
            ]
          },
          {
            "field": "political_contributions_amount",
            "gte": 10000
          }
        ]
      },
      "result": {
        "category": "major_donor_committee",
        "message": "Using personal or corporate funds for $10,000 or more in contributions in a calendar year may qualify the person or entity as a major donor committee.",
        "review": true
      },
      "source": "https://www.fppc.ca.gov/learn/campaign-rules/when-and-where-to-file-campaign-statements/general-purpose-committees/",
      "effective_date": null
    },
    {
      "id": "jurisdiction.county.70pct",
      "status": "active",
      "trigger": {
        "all": [
          {
            "field": "area",
            "eq": "county"
          },
          {
            "field": "county_activity_share",
            "gte": 70
          }
        ]
      },
      "result": {
        "category": "county_general_purpose",
        "message": "More than 70% of contributions and expenditures focused in one county can indicate county committee jurisdiction.",
        "review": true
      },
      "source": "https://www.fppc.ca.gov/learn/campaign-rules/when-and-where-to-file-campaign-statements/general-purpose-committees/",
      "effective_date": null
    },
    {
      "id": "jurisdiction.city.70pct",
      "status": "active",
      "trigger": {
        "all": [
          {
            "field": "area",
            "eq": "city"
          },
          {
            "field": "city_activity_share",
            "gte": 70
          }
        ]
      },
      "result": {
        "category": "city_general_purpose",
        "message": "Activity focused predominantly in one city can indicate city committee jurisdiction; the exact filing test should be confirmed from current FPPC guidance.",
        "review": true
      },
      "source": "https://www.fppc.ca.gov/learn/campaign-rules/when-and-where-to-file-campaign-statements/general-purpose-committees/",
      "effective_date": null
    }
  ]
}